<owl:Class rdf:about="#Terror">
  <rdfs:subClassOf rdf:resource="#Genero"/>
</owl:Class>

<owl:Class rdf:about="#FilmeDeTerror">
  <rdfs:subClassOf rdf:resource="#Filme"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Filme"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temGenero"/>
          <owl:someValuesFrom rdf:resource="#Terror"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#FilmeParaFamilia">
  <rdfs:subClassOf rdf:resource="#Filme"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Filme"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temClassificacao"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#Livre"/>
                <rdf:Description rdf:about="#Maior12"/>
              </owl:unionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#FanDeTerror">
  <rdfs:subClassOf rdf:resource="#Usuario"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Usuario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#gostaDeGenero"/>
          <owl:someValuesFrom rdf:resource="#Terror"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

