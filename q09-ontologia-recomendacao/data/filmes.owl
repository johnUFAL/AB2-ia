</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temIdioma">
  <rdfs:domain rdf:resource="#Filme"/>
  <rdfs:range rdf:resource="#Idioma"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temClassificacao">
