<owl:ObjectProperty rdf:about="#similarA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Filme"/>
  <rdfs:range rdf:resource="#Filme"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dirigiu">
  <rdfs:domain rdf:resource="#Diretor"/>
  <rdfs:range rdf:resource="#Filme"/>
  <owl:inverseOf rdf:resource="#dirigidoPor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#atuou">
  <rdfs:domain rdf:resource="#Ator"/>
  <rdfs:range rdf:resource="#Filme"/>
